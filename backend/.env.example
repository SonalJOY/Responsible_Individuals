# ============================================================
# RESPONSIBLE INDIVIDUALS — BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# Django Secret Key (Generate a random string in production)
DJANGO_SECRET_KEY=ri-django-insecure-secret-key-development-2026
DJANGO_SETTINGS_MODULE=config.settings.development

# Allowed Hosts & CORS
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# DATABASE (SQLite for dev; PostgreSQL for prod)
# ============================================================
POSTGRES_DB=responsible_individuals
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================================
# REDIS & CELERY (Asynchronous Email & Background Tasks)
# ============================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Set to False to route through real Redis + Celery worker;
# Set to True to execute tasks inline in Django without Redis.
CELERY_TASK_ALWAYS_EAGER=False

# ============================================================
# EMAIL DISPATCH CONFIGURATION
# ============================================================
# Option A: Real SMTP Delivery (Gmail / Brevo / AWS SES)
# To receive real emails in your inbox, set EMAIL_BACKEND to smtp:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Option B: Local Console Output (prints to terminal without internet)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Your sender email address (e.g., your Google account)
EMAIL_HOST_USER=your-email@gmail.com

# For Gmail: Use a 16-character "App Password" (NOT your regular Gmail password)
# Generated from: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your-16-char-app-password

DEFAULT_FROM_EMAIL=Responsible Individuals <your-email@gmail.com>
VOLUNTEER_ADMIN_EMAIL=volunteer-coordinator@responsibleindividuals.org

# Application Public URLs
SITE_NAME=Responsible Individuals
SITE_URL=http://localhost:5173
