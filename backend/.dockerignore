# ============================================================
# Docker Build Ignore File — Responsible Individuals Backend
# Context: backend/ directory
# ============================================================

# Version control & repository metadata
.git/
.gitignore

# Environment configurations & secrets
.env
.env.*
!.env.example
*.local
local_settings.py

# Python virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python bytecode, compilation artifacts & caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Testing, coverage & linter caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Local databases & SQLite runtime journals
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal

# Logs & temporary files
*.log
logs/
tmp/

# OS & Editor metadata
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo

# Runtime upload media & generated staticfiles (handled via volumes/collectstatic)
media/
staticfiles/

# Docker build definitions
Dockerfile
.dockerignore

